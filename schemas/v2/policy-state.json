{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:civ-arena:policy-state:2",
  "title": "Civ Arena V2 policy state and spend custody",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "RandomStateV2": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "state", "gauss_next"],
      "properties": {
        "version": {"type": "integer", "minimum": 1},
        "state": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {"type": "integer"}
        },
        "gauss_next": {
          "oneOf": [
            {"type": "string", "minLength": 1, "maxLength": 128},
            {"type": "null"}
          ]
        }
      }
    },
    "PolicyOperationV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agent_id",
        "player_id",
        "turn",
        "sequence",
        "tool",
        "args_json",
        "result_json"
      ],
      "properties": {
        "agent_id": {"$ref": "urn:civ-arena:common:2#/$defs/Identifier"},
        "player_id": {"type": "integer", "minimum": 0},
        "turn": {"type": "integer", "minimum": 0},
        "sequence": {"type": "integer", "minimum": 0},
        "tool": {
          "enum": [
            "get_strategy",
            "recall_lessons",
            "record_lesson",
            "record_prediction",
            "set_goal",
            "write_diary"
          ]
        },
        "args_json": {"type": "string", "minLength": 2, "maxLength": 262144},
        "result_json": {"type": "string", "minLength": 2, "maxLength": 262144}
      }
    },
    "PolicyStateV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "state_id",
        "policy_id",
        "agent_id",
        "player_id",
        "turn",
        "proposal_id",
        "runtime_kind",
        "rng_state",
        "runtime_state_json",
        "operations",
        "telemetry_json",
        "model_posts"
      ],
      "properties": {
        "schema": {"const": 2},
        "state_id": {"$ref": "urn:civ-arena:common:2#/$defs/Digest"},
        "policy_id": {"$ref": "urn:civ-arena:common:2#/$defs/Digest"},
        "agent_id": {"$ref": "urn:civ-arena:common:2#/$defs/Identifier"},
        "player_id": {"type": "integer", "minimum": 0},
        "turn": {"type": "integer", "minimum": 0},
        "proposal_id": {
          "oneOf": [
            {"$ref": "urn:civ-arena:common:2#/$defs/Digest"},
            {"type": "null"}
          ]
        },
        "runtime_kind": {
          "enum": ["scripted", "planner", "llm", "replay", "external"]
        },
        "rng_state": {
          "oneOf": [
            {"$ref": "#/$defs/RandomStateV2"},
            {"type": "null"}
          ]
        },
        "runtime_state_json": {
          "type": "string",
          "minLength": 2,
          "maxLength": 16777216
        },
        "operations": {
          "type": "array",
          "maxItems": 65536,
          "items": {"$ref": "#/$defs/PolicyOperationV2"}
        },
        "telemetry_json": {
          "type": "string",
          "minLength": 2,
          "maxLength": 1048576
        },
        "model_posts": {"type": "integer", "minimum": 0}
      }
    },
    "PolicySpendV2": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "spend_id",
        "policy_id",
        "agent_id",
        "player_id",
        "turn",
        "attempt"
      ],
      "properties": {
        "schema": {"const": 2},
        "spend_id": {"$ref": "urn:civ-arena:common:2#/$defs/Digest"},
        "policy_id": {"$ref": "urn:civ-arena:common:2#/$defs/Digest"},
        "agent_id": {"$ref": "urn:civ-arena:common:2#/$defs/Identifier"},
        "player_id": {"type": "integer", "minimum": 0},
        "turn": {"type": "integer", "minimum": 0},
        "attempt": {"type": "integer", "minimum": 1}
      }
    }
  }
}
